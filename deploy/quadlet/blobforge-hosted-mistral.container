[Unit]
Description=BlobForge Mistral hosted API worker
After=network-online.target blobforge.service
Requires=blobforge.service

[Container]
Image=ghcr.io/tionis/blobforge:latest-worker-hosted
ContainerName=blobforge-hosted-mistral
AutoUpdate=registry
Network=host
EnvironmentFile=/etc/blobforge/hosted-mistral.env
Volume=blobforge-mistral-cache.volume:/var/lib/blobforge-provider:U
ReadOnly=true
ReadOnlyTmpfs=true
NoNewPrivileges=true
DropCapability=all
Exec=recipe-worker --coordinator-url http://127.0.0.1:8080 --provider-account mistral:primary --response-cache /var/lib/blobforge-provider/responses --max-pages 1000 --max-cost-usd 10 --confirm-api-rights

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
MemoryMax=1G
TasksMax=128

[Install]
WantedBy=default.target
