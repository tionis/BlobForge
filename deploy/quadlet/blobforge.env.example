BLOBFORGE_SERVER_CLIENT_TOKEN=replace-with-a-long-random-secret
BLOBFORGE_SERVER_WORKER_TOKENS={"pdf-worker-1":"replace-with-a-different-long-random-secret"}
BLOBFORGE_SERVER_PUBLIC_URL=https://blobforge.example
BLOBFORGE_SERVER_LEASE_SECONDS=900
BLOBFORGE_SERVER_CAPABILITY_TTL=900
BLOBFORGE_SERVER_MAX_RETRIES=3
# Interactive access (OIDC subject must equal the SCIM user's externalId).
BLOBFORGE_SERVER_OIDC_ISSUER=https://auth.example/application/o/blobforge/
BLOBFORGE_SERVER_OIDC_CLIENT_ID=blobforge
BLOBFORGE_SERVER_OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
BLOBFORGE_SERVER_SESSION_SECRET=replace-with-at-least-32-random-bytes
# Authentik should reach this only over its private container network.
BLOBFORGE_SERVER_SCIM_TOKEN=replace-with-a-different-long-random-secret
BLOBFORGE_SERVER_ROLE_GROUPS={"blobforge-admin":"admin","blobforge-operator":"operator","blobforge-viewer":"viewer"}
