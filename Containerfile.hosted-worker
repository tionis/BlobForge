FROM ghcr.io/astral-sh/uv:latest AS uv

FROM python:3.12-slim AS builder

COPY --from=uv /uv /uvx /bin/
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY blobforge/ ./blobforge/
COPY evaluators/mistral/pyproject.toml evaluators/mistral/uv.lock ./evaluators/mistral/
COPY evaluators/mistral/adapter.py ./evaluators/mistral/adapter.py
COPY evaluators/datalab/pyproject.toml evaluators/datalab/uv.lock ./evaluators/datalab/
COPY evaluators/datalab/adapter.py ./evaluators/datalab/adapter.py
RUN uv sync --frozen --no-dev \
    && uv sync --frozen --project evaluators/mistral \
    && uv sync --frozen --project evaluators/datalab
RUN /app/evaluators/mistral/.venv/bin/python -I -S -c "import runpy; runpy.run_path('/app/evaluators/mistral/adapter.py')" \
    && /app/evaluators/datalab/.venv/bin/python -I -S -c "import runpy; runpy.run_path('/app/evaluators/datalab/adapter.py')"

FROM python:3.12-slim

ARG BLOBFORGE_BUILD_REVISION=unknown

COPY --from=uv /uv /uvx /bin/
WORKDIR /app
COPY --from=builder /app /app

ENV PATH="/app/.venv/bin:$PATH" \
    BLOBFORGE_BUILD_REVISION="${BLOBFORGE_BUILD_REVISION}" \
    PYTHONUNBUFFERED=1 \
    UV_CACHE_DIR=/tmp/uv-cache \
    BLOBFORGE_MISTRAL_RESPONSE_CACHE=/var/cache/blobforge/mistral-responses

VOLUME ["/var/cache/blobforge"]
USER 10001
ENTRYPOINT ["blobforge"]
CMD ["recipe-worker"]
