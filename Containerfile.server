FROM ghcr.io/astral-sh/uv:latest AS uv

FROM python:3.12-slim AS builder
COPY --from=uv /uv /uvx /bin/
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY blobforge/ ./blobforge/
RUN uv sync --frozen --no-dev --extra server

FROM python:3.12-slim
ARG BLOBFORGE_BUILD_REVISION=unknown
RUN useradd --system --uid 10001 --create-home blobforge \
    && install -d -o blobforge -g blobforge /var/lib/blobforge
WORKDIR /app
COPY --from=builder /app /app
ENV PATH="/app/.venv/bin:$PATH" \
    BLOBFORGE_BUILD_REVISION="${BLOBFORGE_BUILD_REVISION}" \
    BLOBFORGE_SERVER_DATA_DIR=/var/lib/blobforge \
    PYTHONUNBUFFERED=1
USER 10001
VOLUME ["/var/lib/blobforge"]
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/api/v1/health', timeout=3)"
ENTRYPOINT ["blobforge"]
CMD ["serve", "--host", "0.0.0.0", "--port", "8080"]
